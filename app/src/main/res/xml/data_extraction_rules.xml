<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Los mapas offline pueden ocupar cientos de MB: no se respaldan. -->
        <exclude domain="external" path="maps/" />
        <exclude domain="file" path="maps/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="external" path="maps/" />
    </device-transfer>
</data-extraction-rules>
